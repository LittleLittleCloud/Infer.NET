<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsAotCompatible>true</IsAotCompatible></PropertyGroup>
  <ItemGroup><ProjectReference Include="../DeepInfer.Core/DeepInfer.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="../../native/DeepInfer.Metal/build/libdeepinfer_metal.dylib" Link="libdeepinfer_metal.dylib"
        CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CompileMetalBridge" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
      Inputs="$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/bridge.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/quantized.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/gpu_graph.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/gpu_prefill.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_moe.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_delta.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_bf16.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_bf16_expanded.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_attention_bf16.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/prefill_expert_packed.mm;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/build.sh"
      Outputs="$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/build/libdeepinfer_metal.dylib">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../native/DeepInfer.Metal/build.sh&quot;" />
  </Target>
</Project>
