<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in workaround for this host's api.nuget.org TLS failure.
     Package content and audit metadata still come from official NuGet endpoints. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org-v2" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org-audit" value="https://data.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
</configuration>
